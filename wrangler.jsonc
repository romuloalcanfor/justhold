{
  // Site do JustHold na Cloudflare: homepage, gráfico e API de contas (Workers + assets + D1).
  // Publicar: npx wrangler d1 migrations apply justhold --remote && npx wrangler deploy
  "name": "justhold",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Bot simulado: roda logo depois do fechamento do candle diário (00h05 UTC = 21h05 de Brasília).
  // Quem pode ver a página /bot/: npx wrangler secret put BOT_OWNERS (e-mails separados por vírgula).
  "triggers": { "crons": ["5 0 * * *"] },
  // Áudio das análises (voz do Grok), enviado por scripts/analise.mjs.
  // Criar uma vez: npx wrangler r2 bucket create justhold-audio
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "justhold-audio" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "justhold", "database_id": "17a39828-63ec-4cb8-b004-dca46e35b7d1" }
  ],
  "routes": [
    { "pattern": "justhold.ai", "custom_domain": true },
    { "pattern": "www.justhold.ai", "custom_domain": true }
  ]
}
